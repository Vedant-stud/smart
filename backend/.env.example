# Backend environment variables. Copy this file to ".env" in the backend/
# folder and adjust values as needed - every value below already has a
# working default, so the app runs out of the box with no .env file at all.

APP_NAME=Smart Crop Advisor
ENV=development

# Change this to a long random string before any real deployment.
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite by default (zero setup). Point this at a PostgreSQL URL
# (postgresql://user:pass@host:5432/dbname) for the pgvector-backed
# production setup described in the project abstract.
DATABASE_URL=sqlite:///./smart_crop_advisor.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. The chatbot (RAG) and weather modules are fully functional
# offline with no keys set (see app/services/rag_service.py and
# app/services/weather_service.py for how to wire in a real LLM /
# live weather provider using these once you have keys).
OPENAI_API_KEY=
GEMINI_API_KEY=
WEATHER_API_KEY=
